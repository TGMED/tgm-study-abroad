# Copy this file to .env and fill in real values once you have a Google Form set up.
# Leave everything blank to keep running with local-only lead capture (SQLite only,
# no forwarding) -- the app works fine without any of these set.

# Set this to use Postgres instead of the local SQLite file (e.g. the URL your
# host's Postgres addon injects automatically -- Railway/Render/etc). Leave
# blank for local dev to keep using SQLite with zero setup.
DATABASE_URL=
#
# How to get these values:
#   1. Create a Google Form with fields: Email, Highest qualification, Profession,
#      Destination, City (short-answer / dropdown, matching the lead data below).
#   2. Click "Send", choose the link icon, and open that link in an incognito window.
#   3. Right-click the page -> "View page source" (or just view-source: the URL).
#   4. Search for `name="entry.` -- each form field has a unique entry.NNNNNNNNN ID.
#      Match each ID to the field it belongs to and paste it below.
#   5. The form's submission endpoint is the same URL with "/viewform" replaced by
#      "/formResponse" -- put that full URL in GOOGLE_FORM_ACTION_URL.

GOOGLE_FORM_ACTION_URL=
GOOGLE_FORM_ENTRY_EMAIL=
GOOGLE_FORM_ENTRY_QUALIFICATION=
GOOGLE_FORM_ENTRY_GRADE=
GOOGLE_FORM_ENTRY_PROFESSION=
GOOGLE_FORM_ENTRY_DESTINATION=
GOOGLE_FORM_ENTRY_CITY=

# Login for /admin/leads (HTTP Basic Auth). If ADMIN_PASSWORD is left blank,
# a random one is generated each time the server starts and printed to the
# console -- fine for a quick local look, but set both here for a stable login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# HubSpot CRM: set this one value and every captured lead automatically
# creates/updates a Contact in HubSpot (matched by email) plus a Note with
# the full lead detail (profession, destination, grade, score, etc.) --
# no HubSpot-side setup is strictly required to get this far.
#
# How to get a token:
#   1. In HubSpot: Settings (gear icon) -> Integrations -> Private Apps.
#   2. Click "Create a private app". Give it a name, e.g. "Global Education ROI".
#   3. Under the "Scopes" tab, enable at least:
#        crm.objects.contacts.write
#        crm.objects.contacts.read
#      (and "Engagements" / notes write access, if HubSpot lists it separately
#      under Scopes -- needed for the Note that gets attached to each contact)
#   4. Click "Create app", confirm, then copy the Access Token it shows you
#      (starts with "pat-..."). It's only shown once -- save it somewhere safe.
#   5. Paste it below.
HUBSPOT_ACCESS_TOKEN=

# Optional, for real filterable fields in HubSpot instead of just the Note:
# in HubSpot go to Settings -> Properties -> Contact properties -> Create
# property, and create these as plain "Single-line text" properties with
# these exact internal names (the label/display name can be anything):
#   tgm_qualification, tgm_grade, tgm_profession, tgm_destination, tgm_city,
#   tgm_salary_ngn, tgm_roi_score, tgm_roi_ratio, tgm_lead_source
# If you skip this, the app still works -- it just falls back to sending
# only the email as a structured field, with everything else in the Note.
