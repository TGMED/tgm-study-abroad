# Copy this file to .env and fill in real values as you set each service up.
# Leave everything blank to keep running with local-only SQLite and
# console-logged email/WhatsApp -- the app works fine without any of these set.

# Set this to use Postgres instead of the local SQLite file (e.g. the URL your
# host's Postgres addon injects automatically -- Railway/Render/etc). Leave
# blank for local dev to keep using SQLite with zero setup.
DATABASE_URL=

# Login for /admin/leads, /admin/members, etc. (HTTP Basic Auth). If
# ADMIN_PASSWORD is left blank, a random one is generated each time the
# server starts and printed to the console -- fine for a quick local look,
# but set both here for a stable login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# EmailJS: sends the 6-digit login code, community reply notifications, and
# the weekly activity digest. Leave everything below blank to keep printing
# these to the console instead -- fine for local dev, nothing is blocked on
# setting this up.
#
# How to get these values:
#   1. In EmailJS: Email Services -> note your Service ID.
#   2. Account -> API Keys -> copy the Public Key, then generate a Private
#      Key with "Allow API calls from non-browser applications" enabled
#      (this is a different credential from any public key already used
#      client-side elsewhere -- required since the code/content is built
#      server-side here, not in the browser).
#   3. Create one Email Template per row below (Email Templates -> Create
#      New Template) and paste each Template ID in. Each template's own
#      "To Email" field must be set to {{email}} -- EmailJS resolves the
#      actual recipient from that field, not a separate API parameter. Each
#      template's body should reference the matching template_params sent
#      by this app:
#        OTP template:    {{passcode}}, {{time}} (when the code expires)
#        Reply template:  {{to_name}}, {{replier_name}}, {{room_label}},
#                          {{post_excerpt}}, {{reply_excerpt}}, {{post_url}}
#        Digest template: {{to_name}}, {{week_range}}, {{highlights_text}},
#                          {{community_url}}
EMAILJS_SERVICE_ID=service_y2393ph
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_OTP_TEMPLATE_ID=
EMAILJS_REPLY_TEMPLATE_ID=
EMAILJS_DIGEST_TEMPLATE_ID=

# WhatsApp Cloud API: lets Amara answer students on WhatsApp using the same
# chat logic as the web app (see blueprints/whatsapp.py). Leave blank to
# keep printing outbound messages to the console instead of sending them --
# local dev works fine without this set up.
#
# How to get these values (Meta Business Suite -> WhatsApp -> API Setup):
#   1. WHATSAPP_PHONE_NUMBER_ID: the "Phone number ID" shown on that page
#      for the number you're sending from.
#   2. WHATSAPP_ACCESS_TOKEN: generate a permanent token for your app in
#      Business Settings -> System Users (a temporary token from the API
#      Setup page expires in 24h -- fine for a first test, not for real use).
#   3. WHATSAPP_APP_SECRET: your app's App Secret, under App Settings ->
#      Basic. Used to verify that inbound webhook requests really came from
#      Meta (HMAC-SHA256 over the raw request body).
#   4. WHATSAPP_VERIFY_TOKEN: any string you make up yourself -- enter the
#      *same* value here and in the webhook's "Verify token" field when you
#      configure the webhook URL in the Meta App Dashboard (WhatsApp ->
#      Configuration). Meta echoes it back on setup to prove you control
#      both ends.
#   5. Set the webhook URL itself, in that same Configuration screen, to
#      <your public URL>/webhook/whatsapp -- e.g. an ngrok URL while testing
#      locally, since Meta requires a public HTTPS endpoint.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
